{
  "edition": "2026 Baseline",
  "updated": "2026-07-26",
  "version": 3,
  "note": "Single source of truth for the WMFC scan. Pages read this file. Edit here, redeploy, site updates.",
  "categories": {
    "Tier 1": {"label": "Built for sector", "class": "p1", "def": "Stated purpose is to prepare, credential, support or operate education outside district-run schools."},
    "Tier 2": {"label": "Names sector", "class": "p2", "def": "Institutional text explicitly names private, classical, charter or non-traditional settings — or a dedicated school-choice course exists."},
    "Tier 3": {"label": "Incidental", "class": "p3", "def": "Reaches these educators only as a side effect, or is explicitly built around district partnership."},
    "Tier 0": {"label": "Nothing found", "class": "p0", "def": "No offering identified. Absence of evidence, not evidence of absence."}
  },

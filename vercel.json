{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/data/",
      "destination": "/method/#data",
      "permanent": true
    },
    {
      "source": "/workbench.html",
      "destination": "/",
      "permanent": false
    }
  ]
}